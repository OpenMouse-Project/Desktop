{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    /* Matches vite.config.ts's "~app-entry" alias (main.tsx) so `tsc`
       resolves it too. Points at App.tsx (the desktop entry) since that's
       what plain `tsc` / `npm run build` uses; App.bridge.tsx is still
       typechecked on its own because it's under src/ regardless. */
    "baseUrl": ".",
    "paths": {
      "~app-entry": ["./src/App.tsx"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
