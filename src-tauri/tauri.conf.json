{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMouse Desktop",
  "version": "0.0.19",
  "identifier": "com.snekxs.openmouse-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenMouse Desktop",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "overlay",
        "title": "OpenMouse",
        "url": "index.html",
        "width": 420,
        "height": 58,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNDUwMEY2ODUxMkU4RDgKUldUWTZCS0Y5Z0JGazNDZyt2K0E2K2JxVDdsRUpBOTdueWpEaTZZTzZCM1crTXBiWllLcEdYSkcK",
      "endpoints": [
        "https://github.com/OpenMouse-Project/Desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
