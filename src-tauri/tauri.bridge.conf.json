{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMouse Bridge",
  "identifier": "com.snekxs.openmouse-bridge",
  "build": {
    "beforeBuildCommand": "npm run build:bridge",
    "frontendDist": "../dist-bridge"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenMouse Bridge",
        "width": 320,
        "height": 420,
        "minWidth": 320,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "overlay",
        "title": "OpenMouse",
        "url": "index.html",
        "width": 420,
        "height": 58,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OpenMouse-Project/Desktop/releases/latest/download/latest-bridge.json"
      ]
    }
  }
}
